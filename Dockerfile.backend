FROM node:lts-alpine AS deps
WORKDIR /app/server
COPY server/package*.json ./
RUN npm ci

FROM deps AS build
WORKDIR /app
COPY server ./server
WORKDIR /app/server
RUN npm run build

FROM node:lts-alpine
WORKDIR /app/server
ENV NODE_ENV=production
COPY server/package*.json ./
RUN npm ci --omit=dev
COPY --from=build /app/server/dist ./dist
RUN mkdir -p uploads
EXPOSE 4000
CMD ["node", "dist/server.js"]
